{
  "uid": "objstore-pipeline-__TENANT_UID__",
  "title": "Tiering Pipeline",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["minio", "objstore", "tiering"],
  "refresh": "15s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": [
    {"name": "datasource", "type": "datasource", "query": "prometheus", "current": {"value": "objstore-prometheus-__TENANT_UID__"}},
    {"name": "cluster", "type": "query", "datasource": {"type": "prometheus", "uid": "$datasource"}, "query": "label_values(up{job=~\"objstore-.*\"}, cluster)", "refresh": 1},
    {"name": "tenant", "type": "query", "datasource": {"type": "prometheus", "uid": "$datasource"}, "query": "label_values(up{job=~\"objstore-.*\",cluster=\"$cluster\"}, tenant)", "refresh": 1}
  ]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Full traversal duration p95 (up to 86400s buckets)", "description": "Completed traversal observations include failed traversals. Long scans can exceed the largest finite bucket; inspect scan count and last-success age too.", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(cwm_minio_tierer_scan_duration_seconds_bucket{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 2, "type": "timeseries", "title": "Durable cursor update age", "description": "Seconds since last persisted cursor update, NOT total scan time. Zero can mean no persisted cursor.", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "cwm_minio_tierer_cursor_age_seconds{cluster=\"$cluster\",tenant=\"$tenant\"}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 3, "type": "timeseries", "title": "Transition state observations / second (not unique inventory)", "description": "Objects may be observed repeatedly across scans; do not sum this counter as current tier inventory.", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (state) (rate(cwm_minio_tierer_transitioned_state_total{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval]))", "legendFormat": "{{state}}"}]},
    {"id": 4, "type": "timeseries", "title": "Marker planning/mutation outcomes / second", "description": "Successful marker operations are not completed MinIO ILM transitions; outcomes can include no-ops and audit plans.", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (outcome, result) (rate(cwm_minio_tierer_marker_outcomes_total{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval]))", "legendFormat": "{{outcome}} / {{result}}"}]},
    {"id": 5, "type": "timeseries", "title": "Restore request outcomes / second (not completion)", "description": "Accepted starts/renewals do not prove restore availability. Pending is separately labeled by the service.", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 14, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (action, result) (rate(cwm_minio_tierer_restore_outcomes_total{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval]))", "legendFormat": "{{action}} / {{result}}"}]},
    {"id": 6, "type": "timeseries", "title": "Coverage skips and budget exhaustion / second", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 12, "y": 14, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "rate(cwm_minio_tierer_coverage_skips_total{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval])", "legendFormat": "coverage skips"}, {"refId": "B", "expr": "rate(cwm_minio_tierer_budget_exhaustions_total{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval])", "legendFormat": "{{kind}} budget exhausted"}]},
    {"id": 7, "type": "timeseries", "title": "UTC daily attempted action counts", "description": "Last observed budget use; gauges update when actions reserve budget, not continuously at midnight.", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 21, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "cwm_minio_tierer_budget_used{cluster=\"$cluster\",tenant=\"$tenant\",resource=\"attempts\"}", "legendFormat": "{{kind}}"}]},
    {"id": 8, "type": "timeseries", "title": "UTC daily attempted action bytes", "description": "Bytes represented by attempts, not measured S3 transfer bytes. Restore renewals charge zero bytes.", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 12, "y": 21, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "cwm_minio_tierer_budget_used{cluster=\"$cluster\",tenant=\"$tenant\",resource=\"bytes\"}", "legendFormat": "{{kind}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 9, "type": "timeseries", "title": "Updater request queue depth", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 28, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "cwm_minio_tierer_updater_queue_depth{cluster=\"$cluster\",tenant=\"$tenant\"}", "legendFormat": "{{pod}}"}]},
    {"id": 10, "type": "timeseries", "title": "Updater Redis batch latency p95", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 12, "y": 28, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, pod) (rate(cwm_minio_tierer_updater_batch_duration_seconds_bucket{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval])))", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 11, "type": "timeseries", "title": "Updater batch failures and HTTP rejections / second", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 35, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "rate(cwm_minio_tierer_updater_batch_errors_total{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval])", "legendFormat": "{{pod}} batches"}, {"refId": "B", "expr": "rate(cwm_minio_tierer_updater_http_rejections_total{cluster=\"$cluster\",tenant=\"$tenant\"}[$__rate_interval])", "legendFormat": "{{pod}} / {{reason}}"}]},
    {"id": 12, "type": "timeseries", "title": "Active updater status-code risk overrides", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 12, "y": 35, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "cwm_minio_tierer_updater_risk_override{cluster=\"$cluster\",tenant=\"$tenant\"}", "legendFormat": "{{pod}} / {{risk}}"}]}
  ]
}
