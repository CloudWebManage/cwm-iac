{
  "minio_tierer_image": "ghcr.io/cloudwebmanage/cwm-minio-tierer:REPLACE_WITH_NEW_BUILD_SHA",
  "log_metrics_sidecar_image": "ghcr.io/cloudwebmanage/cwm-iac-minio-log-metrics:REPLACE_WITH_NEW_BUILD_SHA",
  "metrics": true,
  "metrics_retention": "21d",
  "metrics_storage_size": "150Gi",
  "objstore_monitoring": {
    "enabled": true,
    "campaign_targets": ["10.20.30.40:9910"],
    "campaign_run_id": "campaign-test"
  },
  "tierer_config": {
    "low_hours": "72", "low_threshold": "3", "high_hours": "72", "high_threshold": "3",
    "mode": "audit", "apply": "false", "high_include_current": "false", "restore_days": "1",
    "coverage_enabled": "true", "coverage_template": "cwm-test-coverage:2006-01-02T15", "coverage_value": "complete",
    "daily_transition_attempts": "10000", "daily_transition_bytes": "107374182400",
    "daily_restore_attempts": "10000", "daily_restore_bytes": "107374182400",
    "exclude_buckets": "control", "exclude_bucket_prefixes": "system-",
    "chunk_size": "64", "completion_delay": "5m", "retry_delay": "30s",
    "updater_max_body_bytes": "1048576", "updater_max_records": "1000", "updater_queue_size": "128",
    "updater_batch_max_events": "5000", "updater_batch_max_keys": "5000", "updater_batch_max_wait": "50ms"
  },
  "tierer_redis_config": {
    "appendonly": true, "appendfsync": "everysec", "maxmemory_policy": "noeviction", "maxmemory": "1073741824",
    "exporter_enabled": true,
    "resources": {"requests": {"cpu": "250m", "memory": "1536Mi"}, "limits": {"memory": "2Gi"}},
    "exporter_resources": {"requests": {"cpu": "50m", "memory": "64Mi"}, "limits": {"memory": "128Mi"}}
  },
  "tierer_resources": {"requests": {"cpu": "100m", "memory": "128Mi"}, "limits": {"memory": "512Mi"}},
  "updater_resources": {"requests": {"cpu": "100m", "memory": "128Mi"}, "limits": {"memory": "512Mi"}},
  "vector_resources": {"requests": {"cpu": "100m", "memory": "128Mi"}, "limits": {"memory": "512Mi"}},
  "vector_access_config": {"success_only": true, "exclude_tierer_identity": true}
}
